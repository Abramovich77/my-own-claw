# === REQUIRED ===
TELEGRAM_BOT_TOKEN=your_token_here

# === OPTIONAL — uncomment and set as needed ===
# CLAUDE_BIN=/home/olegab/.local/bin/claude
# CLAUDE_WORK_DIR=~/workspace          # isolate from bot dir in production!
# GROQ_API_KEY=your_groq_key_here      # enables voice message transcription
# ALLOWED_USERS=123456789,987654321    # restrict access; set in production!
# ANTHROPIC_API_KEY=your_key_here      # for direct Claude API calls (future use)

# === LOGGING ===
# LOG_MAX_MB=5
# LOG_BACKUP_COUNT=5

# === BOT BEHAVIOUR ===
# HEARTBEAT_INTERVAL=15   # seconds between "still working..." updates during long tasks
